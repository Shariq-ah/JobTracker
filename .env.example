# JobTracker environment variables
# Copy to .env for local runs (never commit .env — see .gitignore).
# Production: set the same names in Render (or your host) — not in the repo.

# --- Required for a real job cycle (Telegram + Bedrock when mock is off) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MONGO_URI=mongodb://localhost:27017/jobtracker

AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_MAX_TOKENS=3000
AWS_BEDROCK_TIMEOUT_SECONDS=30
AWS_BEDROCK_TEMPERATURE=0.0

# --- Local dev without AWS cost (see DEV_MODE_GUIDE.md) ---
# When true, skips real Bedrock calls. AWS keys can stay empty (Spring profile: dev sets this by default).
AI_DEV_MOCK_ENABLED=true

# --- Optional pipeline toggles (defaults exist in application*.properties) ---
AI_BEDROCK_ENABLED=true
AI_BEDROCK_MIN_LOCAL_SCORE=20
CANDIDATE_NOTIFY_MIN_SCORE=50
RESUME_TAILORING_ENABLED=true
RESUME_TAILORING_MIN_SCORE=70
JOB_SCHEDULER_FIXED_DELAY_MS=300000
JOB_SCHEDULER_INITIAL_DELAY_MS=10000
