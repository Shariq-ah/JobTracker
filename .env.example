# JobTracker Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to git!

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# MongoDB
MONGO_URI=mongodb://localhost:27017/jobtracker

# AWS Bedrock Configuration
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_MAX_TOKENS=2000
AWS_BEDROCK_TIMEOUT_SECONDS=30
AWS_BEDROCK_TEMPERATURE=0.0
